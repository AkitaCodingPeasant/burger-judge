HTTP_ADDR=:8080
POSTGRES_USER=regs
POSTGRES_PASSWORD=regs
POSTGRES_DB=regs
# 本機 go run 使用 localhost；Compose 的 api service 會覆寫為 postgres service。
DATABASE_URL=postgres://regs:regs@localhost:5432/regs?sslmode=disable
OPENAPI_SPEC_PATH=./api/openapi.yaml
MIGRATION_DIR=./migrations
JWT_PRIVATE_KEY=./secrets/private.pem
JWT_PUBLIC_KEY=./secrets/public.pem
JWT_TTL_MINUTES=60
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=change-this-admin-password
PROBLEM_FIXTURES_ROOT=./test-framework
PROBLEMS_ROOT=./data/problems
UPLOAD_ROOT=./data/uploads
BUILD_ROOT=./data/builds
JUDGE_IMAGE=yhlib/cs3060701
MAX_JUDGE_WORKERS=2
JUDGE_BUILD_TIMEOUT_MS=120000
JUDGE_TIMEOUT_MS=3000
